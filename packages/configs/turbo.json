{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "cache": true,
      "dependsOn": ["eslint-plugin-no-mercy#build"],
      "inputs": ["./src/**/*.ts", "./rslib.config.ts", "./tsconfig.*.json", "./package.json"],
      "outputLogs": "errors-only",
      "outputs": ["./eslint.mjs", "./eslint.d.ts", "./prettier.mjs", "./prettier.d.ts"],
      "persistent": false
    },
    "compiler__check": {
      "cache": false,
      "dependsOn": ["compiler__check__configs", "compiler__check__lib"],
      "outputLogs": "errors-only",
      "persistent": false
    },
    "compiler__check__configs": {
      "cache": true,
      "dependsOn": ["build"],
      "inputs": ["./src/**/*.ts", "./*.config.ts", "./tsconfig.configs.json", "./typescript/*.json", "./package.json"],
      "outputLogs": "errors-only",
      "persistent": false
    },
    "compiler__check__lib": {
      "cache": true,
      "dependsOn": ["build"],
      "inputs": ["./src/**/*.ts", "./tsconfig.lib.json", "./typescript/*.json", "./package.json"],
      "outputLogs": "errors-only",
      "persistent": false
    },
    "formatter__check": {
      "dependsOn": ["build"],
      "inputs": ["./src/**/*.ts", "./typescript/**/*.json", "./cspell/**/*.json", "./*.{ts,mjs,json}", "!./out-tsc/**"]
    },
    "formatter__fix": {
      "dependsOn": ["build"]
    },
    "linter__check": {
      "dependsOn": ["build"],
      "inputs": ["./src/**/*.ts", "./*.config.ts"]
    },
    "linter__fix": {
      "dependsOn": ["build"]
    }
  }
}
