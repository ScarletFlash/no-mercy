all = false
allow-same-version = false
audit = true
audit-level = info
color = always
engine-strict = true
force = false
format-package-lock = true
fund = false
lockfile-version = 3
loglevel = notice
node-options = --max_old_space_size=9216
progress = true
registry = https://registry.npmjs.org/
save-prefix = ""
shell = bash
strict-ssl = false
