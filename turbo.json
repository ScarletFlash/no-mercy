{
  "$schema": "./node_modules/turbo/schema.json",
  "futureFlags": {
    "globalConfiguration": true
  },
  "global": {
    "inputs": [
      "!./node_modules/",
      "!./packages/**/*tsbuildinfo",
      "!./packages/**/.cspellcache",
      "!./packages/**/.eslintcache",
      "!./packages/**/.prettiercache",
      "!./packages/**/.turbo/",
      "!./packages/**/coverage/",
      "!./packages/**/node_modules/",
      "!./packages/configs/.turbo/**/*",
      "!.cspellcache",
      "!.eslintcache",
      "!.prettiercache",
      "!.turbo/**/*",
      "./packages/configs/**/*",
      ".npmrc",
      "pnpm-*.yaml",
      "turbo.json"
    ],
    "passThroughEnv": ["GITHUB_TOKEN"],
    "ui": "stream"
  },
  "tasks": {
    "//#dependencies-checker__check": {
      "cache": true,
      "dependsOn": ["@no-mercy/configs#build"],
      "inputs": [
        "./packages/**/*.{js,ts,tsx,mjs}",
        "./packages/**/package.json",
        "!./packages/**/out-tsc/",
        "!./packages/**/dist/",
        "!./packages/**/coverage/",
        "!./packages/**/node_modules/"
      ],
      "persistent": false
    },
    "//#compiler__check:root": {
      "cache": true,
      "dependsOn": ["@no-mercy/configs#build"],
      "inputs": [
        "./eslint.config.ts",
        "./prettier.config.ts",
        "./tsconfig.configs.json",
        "./tsconfig.json",
        "./package.json"
      ],
      "outputLogs": "errors-only",
      "persistent": false
    },
    "//#formatter__check:root": {
      "cache": true,
      "dependsOn": ["@no-mercy/configs#build"],
      "inputs": ["./*.*", "!./*tsbuildinfo", "!.cspellcache", "!.prettiercache"],
      "outputLogs": "errors-only",
      "persistent": false
    },
    "//#formatter__fix:root": {
      "cache": false,
      "dependsOn": ["@no-mercy/configs#build"],
      "outputLogs": "errors-only",
      "persistent": false
    },
    "//#spell-checker__check:root": {
      "cache": true,
      "inputs": ["./*.*", "!./*tsbuildinfo", "!.cspellcache", "!.prettiercache"],
      "outputLogs": "errors-only",
      "persistent": false
    },
    "_check-all": {
      "cache": false,
      "dependsOn": [
        "//#dependencies-checker__check",
        "compiler__check",
        "linter__check",
        "formatter__check",
        "spell-checker__check",
        "test__units"
      ],
      "persistent": false
    },
    "_fix-all": {
      "cache": false,
      "dependsOn": ["linter__fix", "formatter__fix"],
      "persistent": false
    },
    "build": {
      "cache": false,
      "outputLogs": "errors-only",
      "persistent": false
    },
    "bump-version": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": false
    },
    "check-all": {
      "cache": false,
      "dependsOn": [
        "//#dependencies-checker__check",
        "compiler__check",
        "linter__check",
        "formatter__check",
        "spell-checker__check",
        "test__units"
      ],
      "outputLogs": "errors-only",
      "persistent": false
    },
    "compiler__check": {
      "cache": true,
      "dependsOn": ["//#compiler__check:root"],
      "inputs": [
        "./**/*.{js,ts,tsx,mjs}",
        "./**/tsconfig.*",
        "./package.json",
        "!./**/*tsbuildinfo",
        "!./out-tsc/",
        "!./dist/",
        "!./coverage/",
        "!./node_modules/"
      ],
      "outputLogs": "errors-only",
      "persistent": false
    },
    "doc:lint": {
      "cache": true,
      "dependsOn": ["build"],
      "inputs": ["./src/**", "./README.md", "./.eslint-doc-generatorrc.*"],
      "outputLogs": "errors-only",
      "persistent": false
    },
    "doc:update": {
      "cache": true,
      "dependsOn": ["build"],
      "inputs": ["./src/**", "./.eslint-doc-generatorrc.*"],
      "outputLogs": "errors-only",
      "outputs": ["./README.md", "./src/rules/**/README.md"],
      "persistent": false
    },
    "formatter__check": {
      "cache": true,
      "dependsOn": ["@no-mercy/configs#build", "//#formatter__check:root"],
      "inputs": [
        "./**/*.{js,mjs,ts,mts,tsx,html,yaml,yml,json,md}",
        "!./out-tsc/",
        "!./dist/",
        "!./coverage/",
        "!./node_modules/"
      ],
      "outputLogs": "errors-only",
      "persistent": false
    },
    "formatter__fix": {
      "cache": false,
      "dependsOn": ["@no-mercy/configs#build", "//#formatter__fix:root"],
      "outputLogs": "errors-only",
      "persistent": false
    },
    "linter__check": {
      "cache": true,
      "dependsOn": ["@no-mercy/configs#build"],
      "inputs": ["./**/*.{js,mjs,ts,mts,tsx,html}", "!./out-tsc/", "!./dist/", "!./coverage/", "!./node_modules/"],
      "outputLogs": "errors-only",
      "persistent": false
    },
    "linter__fix": {
      "cache": false,
      "dependsOn": ["@no-mercy/configs#build"],
      "outputLogs": "errors-only",
      "persistent": false
    },
    "spell-checker__check": {
      "cache": true,
      "dependsOn": ["//#spell-checker__check:root"],
      "inputs": [
        "./**/*",
        "!./**/*tsbuildinfo",
        "!./.cspellcache",
        "!./.eslintcache",
        "!./.prettiercache",
        "!./.turbo/",
        "!./out-tsc/",
        "!./dist/",
        "!./coverage/",
        "!./node_modules/"
      ],
      "outputLogs": "errors-only",
      "persistent": false
    },
    "test__units": {
      "cache": true,
      "dependsOn": ["@no-mercy/configs#build", "^build"],
      "inputs": [
        "./**/*.{js,ts,tsx,mjs}",
        "./**/tsconfig.*",
        "!./**/*tsbuildinfo",
        "!./out-tsc/",
        "!./dist/",
        "!./coverage/",
        "!./node_modules/"
      ],
      "persistent": false
    }
  }
}
